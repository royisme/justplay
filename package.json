{
  "name": "just-play-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "wrangler dev",
    "preview": "bun run build && vite preview",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxlint --fix",
    "typecheck": "bun run cf-typegen && react-router typegen && tsc -b",
    "check": "bun run lint && bun run typecheck",
    "deploy": "bun run check && bun run build && wrangler deploy",
    "deploy:preview": "bun run build && wrangler deploy --env preview",
    "deploy:prod": "bun run check && bun run build && wrangler deploy --env production",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply just-play-db",
    "db:migrate:local": "wrangler d1 migrations apply just-play-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply just-play-db --remote",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed.ts",
    "clean": "rm -rf build .react-router node_modules/.vite",
    "clean:all": "rm -rf build .react-router node_modules .wrangler"
  },
  "packageManager": "bun@1.3.5",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.2",
    "@base-ui/react": "^1.0.0",
    "@openrouter/ai-sdk-provider": "^1.5.4",
    "@phosphor-icons/react": "^2.1.10",
    "@react-router/cloudflare": "^7.11.0",
    "@react-router/node": "^7.11.0",
    "ai": "^6.0.6",
    "drizzle-orm": "^0.45.1",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "isbot": "^5.1.32",
    "mermaid": "^11.12.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.1",
    "react-markdown": "^10.1.0",
    "react-router": "7.11.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.17.1",
    "@cloudflare/workers-types": "^4.20260103.0",
    "@react-router/dev": "7.11.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.8",
    "oxlint": "^1.36.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-tsconfig-paths": "^6.0.3",
    "wrangler": "^4.54.0"
  }
}
