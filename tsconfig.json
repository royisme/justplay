{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "~/*": ["./app/*"],
      "@server/*": ["./server/*"],
      "@shared/*": ["./shared/*"],
    },
    "resolveJsonModule": true,
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "server/**/*.ts",
    "shared/**/*.ts",
    ".react-router/types/**/*.ts",
    "worker-configuration.d.ts",
    "worker.ts"
  ],
  "exclude": ["node_modules", "build", ".wrangler"],
}
